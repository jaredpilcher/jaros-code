# Jaros runtime state (regenerable / mutable). Source lives in
# .jaros-data/agents, .jaros-data/tools, .jaros-data/config, .jaros-data/schedules.
# Throwaway probes (not part of the versioned harness).
.jaros-data/r1_decorrelation.py
.jaros-data/qwen3_repair_probe.py
.jaros-data/inbox/
.jaros-data/outbox/
.jaros-data/processed/
.jaros-data/failed/
.jaros-data/claimed/
.jaros-data/state/
.jaros-data/artifacts/
.jaros-data/status.json
.jaros-data/*.log
.jaros-data/daemon.log
.jaros-data/sessions/

# Real benchmark datasets (large / separately licensed — fetched, not vendored)
evals/benchmarks/

# Python
__pycache__/
*.pyc
.env
evals/benchmarks/*.jsonl
evals/benchmarks/**/*.parquet
evals/benchmarks/*.json
.jcode/

# Claude Code runtime state (keep vendored skills/agents, ignore runtime locks)
.claude/scheduled_tasks.lock
.claude/*.lock

# Grind / SWE-bench prediction output stragglers (runtime state, never commit) — the swebench
# harness writes "<model_name_or_path>.<run_id>.json" to cwd (repo root); grind scripts likewise.
/gold.*.json
/jcode-*.json
/qwen25coder*.json
/qwen3-*.json
/deepseek*.json
/repair.*.json
/r1*.json
